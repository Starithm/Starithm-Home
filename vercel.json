{
  "buildCommand": "npm run install:all && npm run build:all",
  "outputDirectory": "dist",

      "rewrites": [
      { "source": "/assets/(.*)", "destination": "/assets/$1" },

      { "source": "/feed.xml", "destination": "/api/feed" },
      { "source": "/novatrace/events/:id", "destination": "/api/event-page" },

      { "source": "/novatrace", "destination": "/index.html" },
      { "source": "/novatrace/", "destination": "/index.html" },
      { "source": "/novatrace/events/(.*)", "destination": "/index.html" },
      { "source": "/novatrace/(.*)", "destination": "/index.html" },

      { "source": "/home", "destination": "/index.html" },
      { "source": "/home/", "destination": "/index.html" },
      { "source": "/home/(.*)", "destination": "/index.html" },

      { "source": "/blog", "destination": "/index.html" },
      { "source": "/blog/", "destination": "/index.html" },
      { "source": "/blog/posts/(.*)", "destination": "/index.html" },
      { "source": "/blog/(.*)", "destination": "/index.html" },

      { "source": "/ears-to-the-universe", "destination": "/api/melody-page" },
      { "source": "/ears-to-the-universe/", "destination": "/api/melody-page" },
      { "source": "/ears-to-the-universe/:date", "destination": "/api/melody-page" },
      { "source": "/ears-to-the-universe/:date/:trackId", "destination": "/api/melody-page" },
      { "source": "/ears-to-the-universe/(.*)", "destination": "/index.html" },

      { "source": "/sso-callback", "destination": "/index.html" },
      { "source": "/privacy", "destination": "/index.html" }
    ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Link", "value": "</llms.txt>; rel=\"llms-txt\"" }
      ]
    },
    {
      "source": "/(home|novatrace)/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(home|novatrace)/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
